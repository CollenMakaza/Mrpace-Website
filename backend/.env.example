# Copy this file to ".env" and fill in your own values.

PORT=5000

# Long random string used to sign login tokens. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string

# Websites allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# The first admin account is created from these on first start.
ADMIN_EMAIL=admin@mrpace.co.zw
ADMIN_PASSWORD=ChangeThisPassword123
ADMIN_NAME=Mr Pace Admin

# ---- Email (tickets are sent from this account) ----
# For Gmail: turn on 2-step verification and create an "App password".
# If SMTP_HOST is empty, emails are saved to backend/outbox/ instead of being sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mr Pace Athletics Club <no-reply@mrpace.co.zw>"

# ---- Paynow (EcoCash / OneMoney / Visa / ZimSwitch) ----
# Get these from https://www.paynow.co.zw after creating an integration.
# Leave empty to only allow manual payments (runner enters transaction reference).
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Public URL of this backend (Paynow posts payment results here)
PUBLIC_API_URL=http://localhost:5000

# ---- Manual payment details shown to runners ----
MANUAL_PAY_ECOCASH=0771 000 000 (Mr Pace Athletics)
MANUAL_PAY_BANK=CBZ Bank - Acc 0000000000 - Mr Pace Athletics Club
